# Copy to .env.local for local dev, or add to Vercel Project → Settings → Environment Variables.

# MongoDB connection string.
# For Vercel: use MongoDB Atlas (free tier is fine).
# Example: mongodb+srv://user:pass@cluster.mongodb.net/scalbr?retryWrites=true&w=majority
MONGO_URL=

# Optional. If your URI does not include a database name, set this.
# DB_NAME=scalbr

# Public base URL of the deployed app. Vercel will inject this automatically
# via VERCEL_URL, but you can override with a custom domain here.
NEXT_PUBLIC_BASE_URL=
